{
  "name": "coniglio",
  "version": "2.0.0",
  "type": "module",
  "description": "A minimal, elegant, and robust async RabbitMQ client for Node.js",
  "main": "index.cjs",
  "module": "lib/index.esm.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsup",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:package",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "tsx --test test/unit/**/*.test.ts",
    "test:integration": "tsx --test test/integration/**/*.test.ts",
    "test:package": "node --test test/package/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.esm.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./index.cjs"
      }
    }
  },
  "files": [
    "lib/",
    "index.cjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "rabbitmq",
    "amqp",
    "message-queue",
    "queue",
    "pubsub",
    "messaging",
    "streaming",
    "async-iterator",
    "resilient",
    "reconnect",
    "nodejs",
    "typescript",
    "broker",
    "microservices",
    "mq"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "author": "Michele Triaca",
  "license": "MIT",
  "repository": "micheletriaca/coniglio",
  "homepage": "https://github.com/micheletriaca/coniglio",
  "bugs": "https://github.com/micheletriaca/coniglio/issues",
  "dependencies": {
    "amqplib": "^0.10.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.1",
      "sucrase": "^3.35.1"
    }
  }
}
