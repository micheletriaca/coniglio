{
  "name": "coniglio",
  "version": "2.0.0",
  "description": "A minimal, elegant, and robust async RabbitMQ client for Node.js",
  "keywords": [
    "amqp",
    "async-iterator",
    "broker",
    "message-queue",
    "messaging",
    "microservices",
    "mq",
    "nodejs",
    "pubsub",
    "queue",
    "rabbitmq",
    "reconnect",
    "resilient",
    "streaming",
    "typescript"
  ],
  "homepage": "https://github.com/micheletriaca/coniglio",
  "bugs": "https://github.com/micheletriaca/coniglio/issues",
  "license": "MIT",
  "author": "Michele Triaca",
  "repository": "micheletriaca/coniglio",
  "files": [
    "lib/",
    "index.cjs",
    "index.d.cts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "index.cjs",
  "module": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run test:package",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "npm run test:unit",
    "test:unit": "tsx --test test/unit/**/*.test.ts",
    "test:integration": "tsx --test test/integration/**/*.test.ts",
    "test:package": "node --test test/package/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "amqplib": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
